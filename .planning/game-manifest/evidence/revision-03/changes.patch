+"""Native role distribution and user-file preservation, not vendor-discovery tests."""
+import contextlib
+import io
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+
+HOME=Path(__file__).resolve().parents[1]
+sys.dont_write_bytecode=True;sys.path.insert(0,str(HOME/'scripts'))
+import install_manifest
+import render_agents
+
+
+def snapshot(root):return {str(p.relative_to(root)):p.read_bytes() for p in root.rglob('*') if p.is_file() and not p.is_symlink()}
+
+class NativeAgentTests(unittest.TestCase):
+    def setUp(self):
+        self.temp=tempfile.TemporaryDirectory(prefix='native-agent-install-');self.addCleanup(self.temp.cleanup)
+        self.project=Path(self.temp.name)/'project';self.project.mkdir()
+    def install(self,force=False):
+        with contextlib.redirect_stdout(io.StringIO()):install_manifest.install(self.project,force)
+    def run_cli(self,*argv):return subprocess.run([sys.executable,*map(str,argv)],text=True,capture_output=True,env={**os.environ,'PYTHONDONTWRITEBYTECODE':'1'})
+    def test_source_role_formats_match(self):
+        data=render_agents.load_roles();self.assertEqual(len(data['roles']),12)
+        try:import tomllib
+        except ImportError:self.skipTest('native TOML parser is stdlib on Python 3.11+')
+        for role in data['roles']:
+            cid=role['id'];md=(HOME/'.claude/agents'/f'{cid}.md').read_text()
+            body=md.split('---\n',2)[2].strip()
+            codex=tomllib.loads((HOME/'.codex/agents'/f'{cid}.toml').read_text())
+            self.assertEqual(body,codex['developer_instructions'].strip())
+            self.assertNotIn('model',codex)
+    def test_installed_native_roots_and_readonly_renderer(self):
+        self.install()
+        self.assertEqual(len(list((self.project/'.claude/agents').glob('game-design-*.md'))),12)
+        self.assertEqual(len(list((self.project/'.codex/agents').glob('game-design-*.toml'))),12)
+        before=snapshot(self.project)
+        result=self.run_cli(self.project/'.game-design/scripts/render_agents.py','--check')
+        self.assertEqual(result.returncode,0,result.stdout+result.stderr)
+        self.assertEqual(before,snapshot(self.project))
+        self.assertFalse((self.project/'.game-design/.codex').exists())
+    def test_user_native_role_and_config_preserved_even_force(self):
+        target=self.project/'.codex/agents/game-design-designer.toml';target.parent.mkdir(parents=True)
+        target.write_text('name = "my custom designer"\n');config=self.project/'.codex/config.toml';config.write_text('# user configuration\n')
+        self.install(True)
+        self.assertEqual(target.read_text(),'name = "my custom designer"\n')
+        self.assertEqual(config.read_text(),'# user configuration\n')
+        ledger=json.loads((self.project/'.game-design/install.json').read_text())
+        self.assertNotIn('.codex/agents/game-design-designer.toml',ledger['files'])
+    def test_managed_role_rollback_preserves_live_scheduler_state(self):
+        self.install();role=self.project/'.claude/agents/game-design-qa.md';role.write_text('# customized managed QA\n')
+        state=self.project/'.game-design/state/parallel.json';state.write_text('{"live fixture": true}\n')
+        self.install(True)
+        self.assertNotEqual(role.read_text(),'# customized managed QA\n')
+        backups=sorted((self.project/'.game-design/backups').iterdir())
+        last=max(backups,key=lambda p:p.stat().st_mtime_ns)
+        result=self.run_cli(last/'restore.py');self.assertEqual(result.returncode,0,result.stderr)
+        self.assertEqual(role.read_text(),'# customized managed QA\n')
+        self.assertEqual(state.read_text(),'{"live fixture": true}\n')
+    def test_symlink_native_directory_rejected_before_any_payload(self):
+        outside=Path(self.temp.name)/'outside';outside.mkdir()
+        (self.project/'.claude').symlink_to(outside,target_is_directory=True)
+        with self.assertRaises(ValueError),contextlib.redirect_stdout(io.StringIO()):install_manifest.install(self.project)
+        self.assertFalse((self.project/'CLAUDE.md').exists())
+        self.assertEqual(snapshot(outside),{})
+
+if __name__=='__main__':unittest.main()
diff --git a/manifests/game-design/tests/test_parallel.py b/manifests/game-design/tests/test_parallel.py
new file mode 100644
index 0000000..0f3dad9
--- /dev/null
+++ b/manifests/game-design/tests/test_parallel.py
@@ -0,0 +1,580 @@
+"""Black-box parallel state-machine fixtures; no LLM or game-runtime execution claims."""
+from concurrent.futures import ThreadPoolExecutor
+import copy
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+import tempfile
+import time
+import unittest
+
+HOME = Path(__file__).resolve().parents[1]
+ROOT = HOME.parents[1]
+SCRIPT = HOME / 'scripts/parallel.py'
+ROLE = 'game-design-designer'
+
+
+def digest(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def snapshot(root):
+    return {p.relative_to(root).as_posix(): digest(p.read_bytes())
+            for p in root.rglob('*') if p.is_file() and not p.is_symlink()}
+
+
+class ParallelRuntimeTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory(prefix='game parallel fixture ')
+        self.addCleanup(self.temp.cleanup)
+        self.base = Path(self.temp.name)
+        self.project = self.base / 'game project'
+        self.project.mkdir()
+        self.plan_file = self.base / 'plan.json'
+        self.state_file = self.project / '.game-design/state/parallel.json'
+        self.index = 0
+
+    def task(self, identifier='a', **changes):
+        task = {
+            'id': identifier, 'custom_reason': 'Project-specific deterministic test fixture',
+            'role': ROLE, 'depends_on': [],
+            'writes': [f'Work/{identifier}.txt', f'Evidence/{identifier}'],
+            'resources': [], 'inputs': [], 'outputs': [f'Work/{identifier}.txt'],
+            'effect': 'design', 'gates': [],
+        }
+        task.update(changes)
+        return task
+
+    def plan(self, tasks=None, **changes):
+        value = {'schema_version': 1, 'mode': 'design-only', 'max_parallel': 3,
+                 'lease_seconds': 1800, 'gates': [], 'waivers': {},
+                 'tasks': tasks if tasks is not None else [self.task()]}
+        value.update(changes)
+        return value
+
+    def cli(self, *args, expected=0):
+        result = subprocess.run(
+            [sys.executable, str(SCRIPT), '--project', str(self.project), *map(str, args)],
+            cwd=ROOT, capture_output=True, text=True, timeout=30,
+            env={**os.environ, 'PYTHONDONTWRITEBYTECODE': '1'},
+        )
+        self.assertEqual(result.returncode, expected,
+                         f'command={args!r}\nstdout={result.stdout}\nstderr={result.stderr}')
+        if expected:
+            return result
+        try:
+            return json.loads(result.stdout)
+        except json.JSONDecodeError:
+            self.fail(f'Expected JSON output: {result.stdout!r}; stderr={result.stderr!r}')
+
+    def initialize(self, plan=None, expected=0, dry_run=False):
+        self.plan_file.write_text(json.dumps(plan or self.plan()), encoding='utf-8')
+        args = ['init', '--plan', self.plan_file]
+        if dry_run:
+            args.append('--dry-run')
+        return self.cli(*args, expected=expected)
+
+    def state(self):
+        return json.loads(self.state_file.read_text(encoding='utf-8'))
+
+    def claim(self, limit=1, worker='fixture-author'):
+        return self.cli('claim', '--worker', worker, '--limit', limit)['claimed']
+
+    def bind(self, claimed, run_id=None):
+        identifier = claimed['id']
+        self.cli('bind', '--id', identifier, '--token', claimed['claim_token'],
+                 '--run-id', run_id or f'fixture-author-run-{identifier}')
+
+    def put(self, relative, data='fixture evidence, not a game-runtime result\n', workspace=None):
+        root = workspace or self.project
+        path = root / relative
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_bytes(data if isinstance(data, bytes) else data.encode())
+        return path
+
+    def result_file(self, claim, *, status='submitted', workspace=None, artifact=None, **changes):
+        identifier = claim['id']
+        root = workspace or self.project
+        relative = artifact or f'Work/{identifier}.txt'
+        output = self.put(relative, f'fixture output for {identifier}\n', root)
+        evidence = f'Evidence/{identifier}/author.txt'
+        self.put(evidence, workspace=root)
+        value = {
+            'task_id': identifier, 'claim_token': claim['claim_token'], 'status': status,
+            'summary': 'Deterministic file fixture; no LLM or engine execution',
+            'artifacts': [{'path': relative, 'sha256': digest(output.read_bytes())}],
+            'evidence': [evidence],
+            'tests': [{'name': 'fixture bytes', 'status': 'pass',
+                       'command': 'fixture write/read check', 'exit_status': 0}],
+        }
+        value.update(changes)
+        self.index += 1
+        path = self.base / f'result-{identifier}-{self.index}.json'
+        path.write_text(json.dumps(value), encoding='utf-8')
+        return path
+
+    def stage(self, operation, claim, *, actor=None, decision=None, expected=0):
+        identifier = claim['id']
+        evidence = f'Evidence/stages/{identifier}-{operation}.txt'
+        self.put(evidence)
+        args = [operation, '--id', identifier, '--actor', actor or f'fixture-{operation}-{identifier}',
+                '--evidence', evidence]
+        if decision is not None:
+            args += ['--decision', decision]
+        return self.cli(*args, expected=expected)
+
+    def submitted(self, task=None):
+        self.initialize(self.plan([task or self.task()]))
+        claim = self.claim()[0]
+        self.bind(claim)
+        self.cli('submit', '--result', self.result_file(claim))
+        return claim
+
+    def finish(self, claim):
+        self.stage('integrate', claim)
+        self.stage('validate', claim, decision='pass')
+        self.stage('review', claim, decision='pass')
+
+    def test_init_dry_run_and_status_next_are_read_only(self):
+        before = snapshot(self.project)
+        self.initialize(dry_run=True)
+        self.assertEqual(snapshot(self.project), before)
+        self.initialize()
+        before = snapshot(self.project)
+        status = self.cli('status')
+        self.assertEqual(status['tasks']['a']['status'], 'pending')
+        self.assertEqual([t['id'] for t in self.cli('next')['ready']], ['a'])
+        self.assertEqual(snapshot(self.project), before)
+
+    def test_duplicate_init_preserves_state(self):
+        self.initialize()
+        before = snapshot(self.project)
+        self.initialize(expected=2)
+        self.assertEqual(snapshot(self.project), before)
+
+    def test_end_to_end_only_reviewed_done_unlocks_successor(self):
+        self.initialize(self.plan([self.task(), self.task('b', depends_on=['a'])]))
+        self.assertEqual([t['id'] for t in self.cli('next')['ready']], ['a'])
