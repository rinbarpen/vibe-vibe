+            rail = max(sx + sw, tx + tw) + 18
+            start_y, end_y = sy + sh / 2, ty + th / 2
+            path = f"M {sx + sw},{start_y} H {rail} V {end_y} H {tx + tw}"
+            edge_labels.append((rail + 6, (start_y + end_y) / 2 - 7, edge["label"], color, "start"))
