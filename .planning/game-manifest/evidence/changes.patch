+import hashlib
+import importlib.util
+import io
+import json
+import os
+from pathlib import Path
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+import unittest
+import xml.etree.ElementTree as ET
+
+HOME = Path(__file__).resolve().parents[1]
+ROOT = HOME.parents[1]
+SCRIPTS = HOME / 'scripts'
+sys.dont_write_bytecode = True
+sys.path.insert(0, str(SCRIPTS))
+from game_design import load_catalog, detect, render_adapters, check_project
+import game_design
+import install_manifest
+from restore_install import restore
+
+
+def snapshot(root):
+    return {p.relative_to(root).as_posix(): hashlib.sha256(p.read_bytes()).hexdigest()
+            for p in root.rglob('*') if p.is_file() and not p.is_symlink()}
+
+
+class GameDesignTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory(prefix='game design test ')
+        self.addCleanup(self.tmp.cleanup)
+        self.base = Path(self.tmp.name)
+        self.project = self.base / 'project with spaces'
+        self.project.mkdir()
