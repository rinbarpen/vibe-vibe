+    text(56, 49, P['context'], 20, 'muted')
+    text(56, 112, P['title'], T['type']['display'], weight=600)
+    text(56, 153, P['boundary'], 18, 'muted')
+    line(56, 182, 1384, 182)
+
+    for i, stage in enumerate(DATA['stages']):
