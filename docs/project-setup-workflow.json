{
  "schema_version": 1,
  "title": "一句话配置项目：通用 AI harness",
  "description": "AI 理解用户目标并选择或编写 manifest；Python 标准库执行跨平台预览、事务安装与文件核验。图描述规则，不表示某个项目已完成配置或已在宿主激活。",
  "nodes": [
    {
      "id": "start",
      "label": "用户：一句项目目标",
      "kind": "terminal",
      "row": 0,
      "detail": "已有 AI 工具；目标目录保持为用户原始工作目录，不指向来源仓库。"
    },
    {
      "id": "inspect",
      "label": "AI：读取项目与系统事实",
      "kind": "ai",
      "row": 1,
      "detail": "复用既有规则和决定；探测 Git/Python，定位来源、模板和技能；不改全局账号设置。"
    },
    {
      "id": "sources",
      "label": "AI：核验来源和依赖",
      "kind": "check",
      "row": 2,
      "detail": "使用真实目录与清单；缺失子模块按需获取；缺依赖不伪造完成。"
    },
    {
      "id": "select",
      "label": "AI：选择或调整业务契约",
      "kind": "ai",
      "row": 3,
      "detail": "读取完整 manifest 和场景；无适配模板则按 manifest-creator 写业务流程。"
    },
    {
      "id": "decision",
      "label": "用户：决定实质取舍",
      "kind": "human",
      "row": 4,
      "detail": "只处理目标冲突、新约束或保留文件的实质差异，不把技术调查交回用户。",
      "trigger": "现有目标矛盾或出现需要人的新业务取舍。",
      "resume": "无答复保存等待；回答后 AI 继续选择/调整；取消则保留现状。"
    },
    {
      "id": "author",
      "label": "AI：生成缺少的 manifest",
      "kind": "ai",
      "row": 5,
      "detail": "普通 Markdown 业务契约、条件规则、依赖与验收；workflow 源/SVG/渲染器；不改无关模板。"
    },
    {
      "id": "contract",
      "label": "AI：审查契约与安装布局",
      "kind": "check",
      "row": 6,
      "detail": "编译中立规则包，保留作用域与来源；核对链接、图再生；不假设存在宿主工具。"
    },
    {
      "id": "preview",
      "label": "AI：Python 暂存与预览",
      "kind": "ai",
      "row": 7,
      "detail": "不执行 Bash；保留根指令、项目数据与状态，预检所有冲突；dry-run 不写目标。"
    },
    {
      "id": "gate",
      "label": "AI：核对预览和既有文件",
      "kind": "check",
      "row": 8,
      "detail": "缺依赖/冲突先处理，不静默覆盖；默认不 push、上云、安装模型或登录账号。"
    },
    {
      "id": "install",
      "label": "AI：事务安装项目上下文",
      "kind": "ai",
      "row": 9,
      "detail": "PROJECT_RULES + 普通规则 + 完整技能；命名宿主入口可选；保留原内容，备份并核对。"
    },
    {
      "id": "verify",
      "label": "AI：文件与宿主验收",
      "kind": "check",
      "row": 10,
      "detail": "执行 --check 与规则/场景验收；宿主显式读规则或实际发现，未观察项单列。"
    },
    {
      "id": "rollback",
      "label": "AI：自动回退并核对",
      "kind": "ai",
      "row": 10,
      "detail": "应用失败由原事务恢复；保留诊断；修复后重新预览，不能把失败当成功。"
    },
    {
      "id": "done",
      "label": "交付配置，继续原始任务",
      "kind": "terminal",
      "row": 11,
      "detail": "交付路径、验证、未观察项与回退；成功后登记真实项目，索引失败仅警告，不把配置就绪当业务完成。"
    }
  ],
